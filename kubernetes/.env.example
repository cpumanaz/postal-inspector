# Secrets for postal-inspector Kubernetes deployment
# Copy to .env and fill in your values

# Local mail server credentials
MAIL_USER=youruser
MAIL_PASS=your-mailbox-password
MAIL_DOMAIN=yourdomain.com

# Upstream IMAP
UPSTREAM_USER=you@gmail.com
UPSTREAM_PASS=your-app-password
UPSTREAM_SERVER=imap.gmail.com
UPSTREAM_PORT=993

# Anthropic API
ANTHROPIC_API_KEY=sk-ant-your-key-here
